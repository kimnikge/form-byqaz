generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id          Int      @id @default(autoincrement())
  role        String
  industry    String?
  industries  String?
  buyerType   String?
  name        String
  phone       String
  region      String
  status      String   @default("new")
  createdAt   DateTime @default(now())
}
